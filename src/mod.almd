// Minecraft item representation for 1.21.1.
// Reference: https://minecraft.wiki/w/Java_Edition_protocol/Slot_Data
//
// Corresponds to PrismarineJS/prismarine-item.
//
// Usage:
//   import mc_item
//   let slot = mc_item.new_slot(1, 64)  // 64 stone

// --- Types ---

type Slot = {
  item_id: Int,
  count: Int,
  damage: Int,
}

type Inventory = {
  slots: List[Option[Slot]],
  size: Int,
}

// --- Slot ---

fn empty_slot() -> Option[Slot] = none

fn new_slot(item_id: Int, count: Int) -> Option[Slot] =
  some({ item_id: item_id, count: count, damage: 0 })

fn new_slot_with_damage(item_id: Int, count: Int, damage: Int) -> Option[Slot] =
  some({ item_id: item_id, count: count, damage: damage })

fn is_empty(slot: Option[Slot]) -> Bool =
  match slot {
    none => true,
    some(s) => s.count <= 0,
  }

fn stack_size(slot: Option[Slot]) -> Int =
  match slot {
    none => 0,
    some(s) => s.count,
  }

fn item_id(slot: Option[Slot]) -> Int =
  match slot {
    none => -1,
    some(s) => s.item_id,
  }

fn can_stack(a: Option[Slot], b: Option[Slot]) -> Bool =
  match a {
    none => false,
    some(sa) => match b {
      none => false,
      some(sb) => sa.item_id == sb.item_id and sa.damage == sb.damage,
    },
  }

// --- Inventory ---

fn new_inventory(size: Int) -> Inventory =
  { slots: list.repeat(none, size), size: size }

fn player_inventory() -> Inventory = new_inventory(46)
fn chest_inventory() -> Inventory = new_inventory(27)
fn double_chest_inventory() -> Inventory = new_inventory(54)

fn get_slot(inv: Inventory, index: Int) -> Option[Slot] =
  list.get(inv.slots, index) ?? none

fn set_slot(inv: Inventory, index: Int, slot: Option[Slot]) -> Inventory =
  { ...inv, slots: list.set(inv.slots, index, slot) }

fn count_item(inv: Inventory, item_id: Int) -> Int = {
  var total = 0
  for slot in inv.slots {
    match slot {
      some(s) => if s.item_id == item_id then { total = total + s.count } else { () },
      none => (),
    }
  }
  total
}

fn first_empty_slot(inv: Inventory) -> Option[Int] = {
  var found: Option[Int] = none
  for i in 0..inv.size {
    if is_empty(get_slot(inv, i)) and found == none then { found = some(i) } else { () }
  }
  found
}

fn occupied_count(inv: Inventory) -> Int = {
  var count = 0
  for slot in inv.slots {
    if not is_empty(slot) then { count = count + 1 } else { () }
  }
  count
}

// --- Common item IDs (1.21.1 subset) ---

let ITEM_AIR = 0
let ITEM_STONE = 1
let ITEM_DIRT = 10
let ITEM_COBBLESTONE = 14
let ITEM_OAK_PLANKS = 15
let ITEM_OAK_LOG = 52
let ITEM_DIAMOND = 802
let ITEM_IRON_INGOT = 798
let ITEM_GOLD_INGOT = 799
let ITEM_STICK = 825
let ITEM_WOODEN_PICKAXE = 827
let ITEM_STONE_PICKAXE = 828
let ITEM_IRON_PICKAXE = 829
let ITEM_DIAMOND_PICKAXE = 830
let ITEM_WOODEN_SWORD = 831
let ITEM_STONE_SWORD = 832
let ITEM_IRON_SWORD = 833
let ITEM_DIAMOND_SWORD = 834
let ITEM_BREAD = 851
let ITEM_COOKED_BEEF = 898

// --- Tests ---

test "empty slot" {
  assert(is_empty(empty_slot()))
  assert_eq(stack_size(empty_slot()), 0)
  assert_eq(item_id(empty_slot()), -1)
}

test "new slot" {
  let s = new_slot(1, 64)
  assert(not is_empty(s))
  assert_eq(stack_size(s), 64)
  assert_eq(item_id(s), 1)
}

test "can_stack" where [
  "same item"     [a = new_slot(1, 32), b = new_slot(1, 16), want = true],
  "diff item"     [a = new_slot(1, 32), b = new_slot(2, 16), want = false],
  "empty a"       [a = empty_slot(),     b = new_slot(1, 16), want = false],
  "empty b"       [a = new_slot(1, 32), b = empty_slot(),     want = false],
] {
  assert_eq(can_stack(a, b), want)
}

test "inventory basics" {
  var inv = new_inventory(9)
  assert_eq(inv.size, 9)
  assert_eq(occupied_count(inv), 0)
  assert_eq(first_empty_slot(inv), some(0))

  inv = set_slot(inv, 0, new_slot(1, 64))
  inv = set_slot(inv, 3, new_slot(2, 32))
  assert_eq(occupied_count(inv), 2)
  assert_eq(first_empty_slot(inv), some(1))
  assert_eq(item_id(get_slot(inv, 0)), 1)
  assert_eq(item_id(get_slot(inv, 3)), 2)
}

test "count_item" {
  var inv = new_inventory(5)
  inv = set_slot(inv, 0, new_slot(1, 64))
  inv = set_slot(inv, 2, new_slot(1, 32))
  inv = set_slot(inv, 4, new_slot(2, 10))
  assert_eq(count_item(inv, 1), 96)
  assert_eq(count_item(inv, 2), 10)
  assert_eq(count_item(inv, 99), 0)
}

test "player inventory size" {
  assert_eq(player_inventory().size, 46)
}

test "chest sizes" where [
  "single" [inv = chest_inventory(), want = 27],
  "double" [inv = double_chest_inventory(), want = 54],
] {
  assert_eq(inv.size, want)
}

test "slot with damage" {
  let s = new_slot_with_damage(829, 1, 50)
  match s {
    some(slot) => {
      assert_eq(slot.item_id, 829)
      assert_eq(slot.damage, 50)
    },
    none => assert(false),
  }
}
